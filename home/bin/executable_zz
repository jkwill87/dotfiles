#!/usr/bin/env bash
# Interactive zmx session picker using gum.

# if arguments are passed, execute zmx directly
if [ "$#" -eq 1 ]; then
  exec zmx a "$1"
  exit $?
fi

command -v zmx >/dev/null 2>&1 || {
  echo "zz: zmx not installed" >&2
  exit 1
}
command -v gum >/dev/null 2>&1 || {
  echo "zz: gum not installed" >&2
  exit 1
}

names=$(zmx list --short | sort 2>/dev/null)
[ -n "$names" ] || {
  echo "zz: no sessions" >&2
  exit 1
}

name=$(echo "$names" | gum choose) || exit 130
exec zmx attach "$name"
