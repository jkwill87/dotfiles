{{- define "zmxhost" -}}
Host {{ .name }}
  HostName {{ .hostname }}
  User {{ .user }}

Host = {{ .name }}[*]
    HostName {{ .hostname }}
    User {{ .user }}
    RemoteCommand zmx attach (string match -rg '\[([^]]+)\]' '%k')
    RequestTTY yes
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlMaster auto
    ControlPersist 10m
{{- end -}}
