// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false,
  },
  "disable_ai": false,
  "session": {
    "trust_all_worktrees": true,
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_branch_name": true,
  },
  "wrap_guides": [100, 120],
  "use_system_window_tabs": true,
  "auto_install_extensions": {
    "color-highlight": true,
    "dockerfile": true,
    "elixir": true,
    "erlang": true,
    "fish": true,
    "html": true,
    "make": true,
    "nu": true,
    "ruff": true,
    "sql": true,
    "toml": true,
    "vscode-dark-modern": true,
  },
  "ssh_connections": [
    {
      "host": "node.lan",
      "projects": [
        {
          "paths": ["/home/sysadmin"],
        },
      ],
    },
  ],
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "enable_feedback": false,
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
    "profiles": {
      "write": {
        "name": "Write",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_file": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "grep": true,
          "terminal": true,
          "thinking": true,
          "search_web": true,
          "open": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
    },
    "default_profile": "write",
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
  },
  "theme": "VSCode Dark Modern",
  "vim_mode": false,
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrains Mono",
  "gutter": {
    // "line_numbers": false,
    // "code_actions": false,
    // "folds": false,
    "runnables": false,
    "breakpoints": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "languages": {
    "Plain Text": {
      "show_edit_predictions": false,
    },
    "Elixir": {
      "language_servers": [
        "dexter",
        "!expert",
        "!elixir-ls",
        "!next-ls",
        "!lexical",
      ],
    },
    "EEx": {
      "language_servers": [
        "dexter",
        "!expert",
        "!elixir-ls",
        "!next-ls",
        "!lexical",
      ],
    },
    "HEEx": {
      "language_servers": [
        "dexter",
        "!expert",
        "!elixir-ls",
        "!next-ls",
        "!lexical",
      ],
    },
  },
}
