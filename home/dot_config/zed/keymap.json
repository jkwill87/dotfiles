[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-`": "workspace::ToggleBottomDock"
    }
  },
  {
    // go back
    "context": "Editor",
    "bindings": {
      "cmd-[": "pane::GoBack",
      "cmd-]": "pane::GoForward"
    }
  },
  {
    "bindings": {
      "ctrl-alt-cmd-shift-g": "git_graph::Open"
    }
  },
  {
    "bindings": {
      "ctrl-alt-cmd-shift-b": "editor::ToggleBookmark"
    }
  }
]
